<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.26100.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <StartupObject>TheGodFace.App</StartupObject>
    <ApplicationIcon>ic0n.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="ic0n.ico" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="assets\decals\initializing_start.gif" />
    <EmbeddedResource Include="assets\decals\initializing_loop.gif" />
  </ItemGroup>

  <ItemGroup>
    <!-- Face decals travel inside the assembly, so a copied exe renders without the assets folder. -->
    <Resource Include="assets\**\*.png" />
    <!-- Default pose and prompt templates are embedded as the fallback when presets is missing on disk. -->
    <EmbeddedResource Include="presets\face_config.json" />
    <EmbeddedResource Include="presets\prompts\*.txt" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="models\" />
  </ItemGroup>

</Project>
